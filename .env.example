# Ambient temperature configuration for heater chart
# Requires enable_temp="yes" in switch.sh and the log_temp.sh cron job running.
# Copy this file to .env and uncomment ONE of the options below.

# Option A: airport ICAO code (recommended for hangar use)
# On first cron run, LATITUDE and LONGITUDE will be automatically appended
# below after geocoding. Delete those two lines to re-geocode.
# LOCATION=KLMO

# Option B: set coordinates directly
# LATITUDE=45.5051
# LONGITUDE=-122.6750

# ---------------------------------------------------------------------------
# Hangar HVAC (Durastar mini-split via Midea WiFi dongle)
# ---------------------------------------------------------------------------
# These four values are written automatically by `python3 setup_hvac.py`
# after you pair the dongle via the NetHome Plus app. Do not edit by hand.
# HVAC_DONGLE_IP=192.168.1.50
# HVAC_DEVICE_ID=123456789012345
# HVAC_TOKEN=...
# HVAC_KEY=...

# ---------------------------------------------------------------------------
# Monthly email summaries (optional)
# ---------------------------------------------------------------------------
# NOTIFY_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# OLED dashboard touch panel (XPT2046 on the same board as the ILI9341)
# ---------------------------------------------------------------------------
# Defaults work for a 3.2" MSP3218 in landscape rotation. Tune per-panel by
# running `sudo python3 display_loop.py --calibrate` once after wiring up:
# it walks through the 4 corners and prints the values to paste here.
# TOUCH_X_MIN=300
# TOUCH_X_MAX=3900
# TOUCH_Y_MIN=300
# TOUCH_Y_MAX=3900
# TOUCH_AXES_SWAP=1
# TOUCH_X_INVERT=0
# TOUCH_Y_INVERT=0
# TOUCH_PRESSURE_THRESHOLD=150

# ---------------------------------------------------------------------------
# Motion-wake backlight (optional — DFRobot C4001 / SEN0610 mmWave sensor)
# ---------------------------------------------------------------------------
# Turns the panel backlight off when no one's in the hangar, back on when
# motion is sensed (extends LED-backlight life, cuts heat). Off by default.
# To enable:
#   1. Move the panel's LED/backlight pin from VCC to BACKLIGHT_GPIO (GPIO18).
#   2. Wire the C4001 to the SAME I2C bus the touch chip uses:
#      VCC->3.3V, GND->GND, SDA->GPIO2, SCL->GPIO3.  `i2cdetect -y 1` → 2a + 38.
#   3. Install the lib: git clone https://github.com/DFRobot/DFRobot_C4001
#      and put its python/raspberrypi dir on PYTHONPATH (or copy
#      DFRobot_C4001.py next to display_loop.py). It also needs pyserial +
#      smbus: sudo apt-get install -y python3-serial python3-smbus
#   4. Aim/tune: `python3 display_loop.py --presence-test`
#   5. Set PRESENCE_ENABLED=1 and `sudo systemctl restart display`.
# PRESENCE_ENABLED=1
# PRESENCE_MODE=motion        # motion=12m moving (SPEED_MODE); presence=8m incl. still (EXIST_MODE)
# PRESENCE_I2C_ADDR=0x2A
# PRESENCE_I2C_BUS=1
# --- Sensor tuning (optional; each knob is opt-in — unset = leave the C4001's
#     own flash config alone). Watch the "tuning:" line --presence-test prints
#     on start to confirm what took effect. Setters persist to sensor flash.
# PRESENCE_RANGE_MIN_CM=150   # ignore returns closer than this (kills near-field clutter/multipath)
# PRESENCE_RANGE_MAX_CM=1200  # detection reach in cm (240-2000; ~1200 = 12 m)
# PRESENCE_RANGE_TRIG_CM=1200 # distance within which a target triggers (240-2000; defaults to MAX)
# PRESENCE_TRIG_SENS=4        # trigger sensitivity 0-9 (LOWER = fewer false wakes); default = sensor's
# PRESENCE_KEEP_SENS=6        # sustain sensitivity 0-9 (how readily it holds a target once seen)
# PRESENCE_FRETTING=off       # micro-motion detection on/off; off = ignore tiny movement, fewer phantoms
# IDLE_TIMEOUT_SECS=120       # backlight sleeps this long after last motion/touch (rolling timer)
# BACKLIGHT_GPIO=18
# BACKLIGHT_FADE_SECS=0.4     # fade duration; 0 = instant on/off
