# Ambient temperature configuration for heater chart
# Requires enable_temp="yes" in switch.sh and the log_temp.sh cron job running.
# Copy this file to .env and uncomment ONE of the options below.

# Option A: airport ICAO code (recommended for hangar use)
# On first cron run, LATITUDE and LONGITUDE will be automatically appended
# below after geocoding. Delete those two lines to re-geocode.
# LOCATION=KLMO

# Option B: set coordinates directly
# LATITUDE=45.5051
# LONGITUDE=-122.6750

# ---------------------------------------------------------------------------
# Hangar HVAC (Durastar mini-split via Midea WiFi dongle)
# ---------------------------------------------------------------------------
# These four values are written automatically by `python3 setup_hvac.py`
# after you pair the dongle via the NetHome Plus app. Do not edit by hand.
# HVAC_DONGLE_IP=192.168.1.50
# HVAC_DEVICE_ID=123456789012345
# HVAC_TOKEN=...
# HVAC_KEY=...

# ---------------------------------------------------------------------------
# Monthly email summaries (optional)
# ---------------------------------------------------------------------------
# NOTIFY_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# FlashAir sync status line on the main page (optional)
# ---------------------------------------------------------------------------
# Poll the flashair-sync daemon (running on the `pi` host) for its
# GET /status endpoint and show "FlashAir: N files, X ago" next to the
# Hangar / Outdoor temps in the chart header. Empty value = use the
# default URL. Omit the line entirely to disable the feature.
# FLASHAIR_STATUS_URL=http://pi.local:8765/status
